# Kopargaon Mobility OS - Supabase Integration Environment Variables
# Copy this file to .env.local when connecting to a live Supabase instance.
# No credentials are required for local mock and deterministic simulation mode.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Operational Telemetry Configuration
NEXT_PUBLIC_DATA_SOURCE_MODE=DEMO_SIMULATION
NEXT_PUBLIC_MAP_DEFAULT_LAT=19.8856
NEXT_PUBLIC_MAP_DEFAULT_LNG=74.4789
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=13
